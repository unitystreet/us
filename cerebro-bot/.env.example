# Token que te da @BotFather al crear el bot con /newbot
BOT_TOKEN=

# Tu chat id de Telegram (opcional). Sirve para que el bot solo te responda
# a ti y no a cualquiera que lo encuentre. Se puede obtener hablándole al
# bot @userinfobot.
OWNER_CHAT_ID=

# API key de Anthropic (console.anthropic.com/settings/keys). Sin esto el
# bot arranca pero no piensa de verdad.
ANTHROPIC_API_KEY=
