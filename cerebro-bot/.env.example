# Token que te da @BotFather al crear el bot con /newbot
BOT_TOKEN=

# Tu chat id de Telegram (opcional). Sirve para que el bot solo te responda
# a ti y no a cualquiera que lo encuentre. Se puede obtener hablándole al
# bot @userinfobot.
OWNER_CHAT_ID=

# API key de Gemini (aistudio.google.com/apikey) — gratis, se saca con
# cualquier cuenta de Google, sin tarjeta. Sin esto el bot arranca pero no
# piensa de verdad.
GEMINI_API_KEY=
